            },
            DEPENDENCY_FAILURE: {
                weight: 0.87,
                subTypes: ['SERVICE_DOWN', 'API_TIMEOUT', 'LIBRARY_BUG', 'DATABASE_LOCK', 'CACHE_MISS', 'DATABASE_ISSUE'],
