            },
            NETWORK_FAILURE: {
                weight: 0.88,
                subTypes: ['DNS_FAILURE', 'PACKET_LOSS', 'LATENCY_SPIKE', 'ROUTING_LOOP', 'FIREWALL_BLOCK'],
                detectionMethods: ['packet_analysis', 'traceroute', 'dns_check', 'connectivity_test']
            },
            CODE_DEFECT: {
                weight: 0.92,
                subTypes: ['NULL_POINTER', 'RACE_CONDITION', 'MEMORY_CORRUPTION', 'INFINITE_LOOP', 'LOGIC_ERROR'],
