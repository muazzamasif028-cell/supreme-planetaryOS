        };

        // =============================================
        // CAUSALITY GRAPH
        // =============================================
        this.causalityGraph = {
            nodes: new Map(),
            edges: new Map(),
            depth: 0
        };

        // =============================================
        // ROOT CAUSE CATEGORIES
        // =============================================
        this.categories = {
            CONFIGURATION: {
                weight: 0.85,
                subTypes: ['MISCONFIG', 'MISSING_PARAM', 'WRONG_VALUE', 'VERSION_MISMATCH'],
                detectionMethods: ['config_diff', 'dependency_check', 'version_compare']
            },
            RESOURCE_EXHAUSTION: {
                weight: 0.90,
                subTypes: ['CPU_SPIKE', 'MEMORY_LEAK', 'DISK_FULL', 'FD_EXHAUSTION', 'THREAD_POOL'],
