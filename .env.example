# MongoDB Atlas
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/supreme-auth
NEOM_TELEMETRY_MONGODB=true

# Application
NODE_ENV=development
PORT=3000

# Cloudflare Registrar
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_REGISTRAR_MODE=sandbox
