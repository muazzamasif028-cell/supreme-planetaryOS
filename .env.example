# MongoDB Atlas
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/supreme-auth
NEOM_TELEMETRY_MONGODB=true
# Cloudflare Registrar
CLOUDFLARE_EMAIL=your_cloudflare_email

# Application
NODE_ENV=development
PORT=3000


# Use "sandbox" for non-billable Registrar testing.
[200~cat >> .env.example <<'EOF'


# Use "sandbox" for non-billable Registrar testing.
# Use "live" only when you intentionally want real Registrar operations.

[200~cat >> .env.example <<'EOF'


# Use "sandbox" for non-billable Registrar testing.
# Use "live" only when you intentionally want real Registrar operations.

# Cloudflare Registrar
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_REGISTRAR_MODE=sandbox
